# --- Postgres (remote) ---
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGHOST=your-remote-host
# PGPORT=5432
# PGUSER=youruser
# PGPASSWORD=yourpassword
# PGDATABASE=yourdb
DB_SCHEMA=TM

# --- Scrape scope (optional; sensible defaults in config.py) ---
TM_QUERY=nfl
TM_REGION=200
TM_START_DATE=          # YYYY-MM-DD; blank = today
TM_END_DATE=            # YYYY-MM-DD; blank = today + 180 days

# --- Behaviour ---
SEAT_MODE=available     # 'available' (only seats for sale) or 'full' (whole manifest)
CONCURRENCY=12          # simultaneous event-detail fetches
HEADLESS=true           # run Playwright headless
REFRESH_MANIFEST=false  # true = always refetch manifests, false = use on-disk cache
