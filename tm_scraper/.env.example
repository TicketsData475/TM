# --- Postgres (remote) ---
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGHOST=your-remote-host
# PGPORT=5432
# PGUSER=youruser
# PGPASSWORD=yourpassword
# PGDATABASE=yourdb
DB_SCHEMA=TM

# --- Scrape scope (optional; sensible defaults in config.py) ---
TM_QUERY=nfl
TM_REGION=200
TM_START_DATE=          # YYYY-MM-DD; blank = today
TM_END_DATE=            # YYYY-MM-DD; blank = today + 180 days

# --- Behaviour ---
SEAT_MODE=available     # 'available' (only seats for sale) or 'full' (whole manifest)
HEADLESS=false          # MUST be false: Kasada blocks headless. We drive real Chrome.
BROWSER_CHANNEL=chrome  # real Google Chrome (best vs Kasada); "" = patchright's bundled Chromium
REFRESH_MANIFEST=false  # true = always refetch manifests, false = use on-disk cache

# --- Proxies (same system as axs-scraper-2; optional) ---
PROXY_ENABLED=false     # true to route facets/manifest fetches + the browser through proxies
# Source order: proxies DB by id -> single proxy.
#
# Option A (preferred, like axs): the shared proxies DB, pick proxies by id.
#   Copy these values from the axs-scraper-2 .env (same infra DB).
PROXIES_DB_HOST=
PROXIES_DB_PORT=5432
PROXIES_DB_NAME=
PROXIES_DB_USER=
PROXIES_DB_PASSWORD=
PROXY_DB_IDS=              # e.g. 60001,60002,60003
PROXY_DB_CLAIM_MODE=true   # true = claim/release + rotate (SKIP LOCKED); false = static round-robin over the ids
PROXY_DB_STALE_MINUTES=10  # auto-reclaim claims abandoned by a crashed run
#
# Option B: a single proxy
PROXY_TYPE=http
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
