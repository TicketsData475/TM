# Copy to .env.local for local dev; on Vercel set these as Project
# Environment Variables (Production + Preview). Never commit real values.

# --- Postgres connection (read by lib/db.js) ---
PGHOST=your-db-host
PGPORT=5432
PGUSER=your-db-user            # prefer a least-privilege user, not the superuser
PGPASSWORD=your-db-password
PGDATABASE=your-db-name

# --- Deploy options ---
# Encrypt DB traffic over the public internet (Vercel -> your DB).
# NOTE: this Postgres server currently has SSL turned OFF, so LEAVE THIS
# UNSET. Setting it to "require" makes every query fail with
# "server does not support SSL connections" (-> 500). Only set it to
# "require" after you enable SSL on the Postgres server.
# PGSSL=require

# Max pool connections PER serverless instance (default 3). Raise only
# if your Postgres max_connections can handle instances * this number.
PGPOOLMAX=3

# On the aceify-only deployment, set to 1 so the bare domain "/"
# redirects to /aceify. Leave unset for a TC or combined deployment.
ACEIFY_ONLY=1
